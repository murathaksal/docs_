{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "denetci-ai/sema/g3",
  "title": "G3 — Denetçi sorusu üretme çıktısı",
  "description": "Bulgu karşısında bir denetçinin soracağı 1–3 soru. Her soru mevzuat maddesine atıf taşır.",
  "type": "object",
  "required": ["sorular"],
  "additionalProperties": false,
  "properties": {
    "sorular": {"type": "array", "minItems": 1, "maxItems": 3,
      "items": {"type": "object", "required": ["soru", "mevzuat_ref", "amac"], "additionalProperties": false,
        "properties": {
          "soru":  {"type": "string", "minLength": 20, "maxLength": 300},
          "mevzuat_ref": {"type": "string", "minLength": 6},
          "amac":  {"enum": ["kanıt talebi", "hipotez ayrıştırma", "politika tespiti", "kapsam doğrulama", "risk uyarısı"]}
        }}}
  }
}
